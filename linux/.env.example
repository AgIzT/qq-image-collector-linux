# 宿主机持久化目录。可使用独立数据盘的绝对路径。
QQAI_RUNTIME_ROOT=./runtime

# 留空时 NapCat 会在日志中显示二维码；不要在 Windows 与 Linux 同时登录同一账号。
QQ_ACCOUNT=
# 可选。腾讯使快速登录身份失效时，用 QQ 密码自动回退，二者只填一个。
# .env 必须保持 600 权限，且不得提交到版本库。
NAPCAT_QUICK_PASSWORD=
NAPCAT_QUICK_PASSWORD_MD5=

# 所有端口默认只绑定服务器 127.0.0.1，外部不能直接访问。
NAPCAT_WEBUI_PORT=16099
# 仅在明确接受普通 HTTP 暴露风险时把 NAPCAT_PUBLIC_BIND 改为 0.0.0.0。
# 公网 WebUI 必须先轮换为高强度随机 Token；不要公开 OneBot 或 QCE。
NAPCAT_PUBLIC_BIND=127.0.0.1
NAPCAT_PUBLIC_WEBUI_PORT=10058
QCE_WEB_PORT=40653
COLLECTOR_CONSOLE_PORT=17890
COLLECTOR_LOCAL_FORWARD_PORT=17891
# 只有显式改成 0.0.0.0 才会公开；同时必须在 manager_config.json
# 配置 direct_public_enabled、direct_public_hosts 和 direct_public_port。
COLLECTOR_PUBLIC_BIND=127.0.0.1
COLLECTOR_PUBLIC_PORT=17891

# 专用采集服务器只需保留很短的 QQ 媒体缓存；最终图片仓库不受影响。
QQAI_CACHE_KEEP_DAYS=1
QQAI_CACHE_THUMBNAIL_KEEP_DAYS=1

# 已验证的 QCE 镜像；升级前先在停机副本验证。
NAPCAT_QCE_IMAGE=ghcr.io/shuakami/napcat-qce@sha256:2fa905fe7c4676f8a3324ba1155a250d28e73d6ed7c3fce50a3986235c63c649
