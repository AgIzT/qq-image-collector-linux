# Persistent host directory. Keep this file chmod 600 and never commit .env.
QQAI_RUNTIME_ROOT=./runtime
QQ_ACCOUNT=
NAPCAT_UID=0
NAPCAT_GID=0

# Public NapCat WebUI requested for this deployment. Protect it with its own
# strong WebUI token and a host firewall; OneBot 3000/3001 are never published.
NAPCAT_WEBUI_PORT=16099
NAPCAT_PUBLIC_BIND=0.0.0.0
NAPCAT_PUBLIC_WEBUI_PORT=10058
NAPCAT_WEBUI_TOKEN=

# Nginx on the host forwards public port 18080 to this loopback-only endpoint.
COLLECTOR_CONSOLE_PORT=17890

# Pinned official multi-arch manifest. Review NapCat source before changing it.
NAPCAT_IMAGE=mlikiowa/napcat-docker@sha256:e66a6e52dc5dd63a2b8537651bafad50255d021584c113a8bbb2cc0ff94bd772
